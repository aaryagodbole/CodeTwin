{
  "name": "codetwin",
  "displayName": "CodeTwin AI",
  "description": "See which tests your change needs, what the analysis cannot see, and the risk left behind.",
  "version": "0.1.0",
  "publisher": "codetwin",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.codetwin.toml",
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codetwin.selectTests",
        "title": "CodeTwin: Select tests for my change"
      },
      {
        "command": "codetwin.impact",
        "title": "CodeTwin: Show impact of this file"
      },
      {
        "command": "codetwin.record",
        "title": "CodeTwin: Record evidence (run full suite with coverage)"
      },
      {
        "command": "codetwin.explain",
        "title": "CodeTwin: Explain last decision"
      },
      {
        "command": "codetwin.showImpactGraph",
        "title": "CodeTwin: Show impact graph of selection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codetwin.showImpactGraph",
          "when": "resourceLangId == python",
          "group": "navigation@1"
        },
        {
          "command": "codetwin.impact",
          "when": "resourceLangId == python",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "CodeTwin AI",
      "properties": {
        "codetwin.cliPath": {
          "type": "string",
          "default": "codetwin",
          "description": "Path to the codetwin command-line tool."
        },
        "codetwin.alpha": {
          "type": "number",
          "default": 0.1,
          "description": "Target miss rate."
        },
        "codetwin.installCommand": {
          "type": "string",
          "default": "pip install \"codetwin @ git+https://github.com/aaryagodbole/CodeTwin@main\"",
          "description": "Command run in a terminal when the CLI is missing."
        },
        "codetwin.graph.hover": {
          "type": "boolean",
          "default": true,
          "description": "Show impact summary when hovering a function, class or selection."
        },
        "codetwin.graph.followSelection": {
          "type": "boolean",
          "default": true,
          "description": "Update the impact graph as the selection changes."
        }
      }
    },
    "keybindings": [
      {
        "command": "codetwin.showImpactGraph",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorLangId == python"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ && node -e \"require('fs').copyFileSync(require.resolve('cytoscape/dist/cytoscape.min.js'),'media/cytoscape.min.js')\"",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.90.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aaryagodbole/CodeTwin.git",
    "directory": "extensions/vscode"
  },
  "dependencies": {
    "cytoscape": "^3.34.4"
  },
  "preview": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "keywords": [
    "testing",
    "regression test selection",
    "impact analysis",
    "python",
    "pytest",
    "coverage",
    "risk"
  ],
  "homepage": "https://github.com/aaryagodbole/CodeTwin#readme",
  "bugs": {
    "url": "https://github.com/aaryagodbole/CodeTwin/issues"
  }
}
