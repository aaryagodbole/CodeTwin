{
  "name": "codetwin",
  "displayName": "CodeTwin AI",
  "description": "See which tests your change needs, what the analysis cannot see, and the risk left behind.",
  "version": "0.1.0",
  "publisher": "codetwin",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Testing", "Other"],
  "activationEvents": ["workspaceContains:.codetwin.toml"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "codetwin.selectTests", "title": "CodeTwin: Select tests for my change" },
      { "command": "codetwin.impact", "title": "CodeTwin: Show impact of this file" },
      { "command": "codetwin.record", "title": "CodeTwin: Record evidence (run full suite with coverage)" },
      { "command": "codetwin.explain", "title": "CodeTwin: Explain last decision" }
    ],
    "menus": {
      "editor/context": [ { "command": "codetwin.impact", "when": "resourceLangId == python", "group": "navigation" } ]
    },
    "configuration": {
      "title": "CodeTwin AI",
      "properties": {
        "codetwin.cliPath": { "type": "string", "default": "codetwin", "description": "Path to the codetwin command-line tool." },
        "codetwin.alpha": { "type": "number", "default": 0.1, "description": "Target miss rate." }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
