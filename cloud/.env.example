# CodeTwin Cloud API (cloud/README.md). Copy and load before running it:
#   cp .env.example .env && set -a && source .env && set +a
# .env is not committed.

# Postgres the API stores reports in. Local example: Postgres.app, or
#   docker run --rm -e POSTGRES_PASSWORD=pw -p 5432:5432 postgres:16
DATABASE_URL=postgresql://postgres:pw@localhost:5432/postgres

# Dashboards allowed to read the API from a browser (comma-separated). The local dashboard runs on port 3000.
CODETWIN_CORS_ORIGINS=http://localhost:3000

# Secret for the daily retention job (GET /api/cron/retention). Any random string locally: openssl rand -hex 24
CRON_SECRET=

# Tests only: a database the tests may WIPE (drop schema public). Never your real one.
# CODETWIN_TEST_DATABASE_URL=postgresql://postgres:pw@localhost:5432/codetwin_test
