# Keep LF line endings in the repository and in checkouts, also on Windows (Git for Windows would otherwise
# convert to CRLF, and bash scripts then fail with "$'\r': command not found").
* text=auto eol=lf
*.sh text eol=lf
*.png binary
*.ico binary
*.vsix binary
# Generated data (scripts/repo_snapshot.py, scripts/demo_snapshot.py): collapsed in pull request diffs and
# left out of the language statistics. Regenerate with the script, never edit by hand.
dashboard/public/snapshot/** linguist-generated=true
dashboard/public/demo/** linguist-generated=true
