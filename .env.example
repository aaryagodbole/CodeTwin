# Environment variables for CodeTwin, with no real values. Copy what you need:
#   cp .env.example .env        (never commit .env: it is in .gitignore)
# Python does not read .env by itself. Load it into the terminal before running commands:
#   set -a; source .env; set +a
# Never put a real key in this file, a commit, an issue or a chat.

# --- AI explanations (optional; `codetwin llm --test`, docs/llm.md). Both have free tiers. -------------------
GROQ_API_KEY=                     # https://console.groq.com/keys
GEMINI_API_KEY=                   # https://aistudio.google.com/apikey

# --- Self-hosting with Docker Compose (only for `docker compose up`, docs/self-hosting.md) ------------------
# Compose reads .env next to compose.yaml. Make random values, e.g. `openssl rand -hex 24`, BEFORE the first up:
# Postgres keeps the password it was created with.
POSTGRES_PASSWORD=
CRON_SECRET=
CODETWIN_CORS_ORIGINS=http://localhost:3000
