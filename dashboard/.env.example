# Dashboard settings (Next.js reads them at build/dev time). Copy to .env.local and pick ONE block:
#   cp .env.example .env.local
# .env.local is not committed. .env.development (committed) already points `npm run dev` at codetwin serve.

# 1. live (default): your own project through `codetwin serve` on port 8765
NEXT_PUBLIC_DATA_MODE=live
NEXT_PUBLIC_API_URL=http://127.0.0.1:8765

# 2. cloud: the hosted data of a project (decisions from CodeTwin Cloud, graph from public/snapshot/)
# NEXT_PUBLIC_DATA_MODE=cloud
# NEXT_PUBLIC_API_URL=https://codetwin-api.vercel.app      # or http://localhost:8080 for a local cloud API
# NEXT_PUBLIC_PROJECT=aaryagodbole/CodeTwin

# 3. demo: the snapshot of examples/python in public/demo/ (no API needed). `npm run dev:demo` sets it for you.
# NEXT_PUBLIC_DATA_MODE=demo
